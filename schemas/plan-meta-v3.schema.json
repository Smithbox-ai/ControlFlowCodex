{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlFlow v3 task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "tier",
    "baseline",
    "scope",
    "criteria",
    "checks",
    "commit"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "goal": {
      "$ref": "#/$defs/text"
    },
    "tier": {
      "enum": [
        "SMALL",
        "MEDIUM",
        "LARGE"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty_paths"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "working_directory",
          "criteria"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "command": {
            "$ref": "#/$defs/text"
          },
          "working_directory": {
            "$ref": "#/$defs/text"
          },
          "criteria": {
            "$ref": "#/$defs/ids"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "required"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "impact",
          "resolved"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "impact": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "resolved": {
            "type": "boolean"
          },
          "mitigation": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "depends_on": {
            "$ref": "#/$defs/ids"
          },
          "criteria": {
            "$ref": "#/$defs/ids"
          },
          "scope": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "checks": {
            "$ref": "#/$defs/ids"
          }
        }
      }
    }
  }
}
