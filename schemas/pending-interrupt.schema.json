{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlFlow native pending interrupt notification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interrupt_id", "task_id", "run_id", "binding", "reason", "native_evidence"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "interrupt_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "reason": {"const": "INTERRUPT"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["worktree_realpath", "git_dir_realpath", "session_id"],
      "properties": {
        "worktree_realpath": {"type": "string", "minLength": 1},
        "git_dir_realpath": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "native_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "turn_id", "received_at"],
      "properties": {
        "event": {"const": "Interrupt"},
        "turn_id": {"type": ["string", "null"]},
        "received_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
