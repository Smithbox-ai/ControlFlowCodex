{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Smithbox-ai/ControlFlowCodex/schemas/plan-meta.schema.json",
  "title": "ControlFlow Plan Metadata",
  "description": "Structured sidecar for a ControlFlow Markdown plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_path",
    "goal",
    "complexity_tier",
    "phases",
    "semantic_risks",
    "success_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_path": {
      "type": "string",
      "pattern": "^plans/.+-plan\\.md$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "complexity_tier": {
      "enum": ["TRIVIAL", "SMALL", "MEDIUM", "LARGE"]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "semantic_risks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/semanticRisk"
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "dependencies",
        "files",
        "commands",
        "success_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "semanticRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "applicability", "impact"],
      "properties": {
        "category": {
          "enum": [
            "data_volume",
            "performance",
            "concurrency",
            "access_control",
            "migration_rollback",
            "dependency",
            "operability"
          ]
        },
        "applicability": {
          "enum": ["applicable", "not_applicable"]
        },
        "impact": {
          "enum": ["LOW", "MEDIUM", "HIGH"]
        }
      }
    }
  }
}
